# 211: `return` from each arm of an else-if chain. §6 `.46`: bodies of
# `if`/`else`/`while` are always braced so there is no dangling else, and an
# `else if` chain is `els: vec![Stmt::If{..}]` in the frozen §3 AST — the third
# `return` is therefore two `If` nodes deep.
# The single `print` with three arguments is tab-separated, one line (§2).
--- source
fn sign(n) {
  if n < 0 {
    return -1;
  } else if n == 0 {
    return 0;
  } else {
    return 1;
  }
}
print sign(-5), sign(0), sign(7);
--- expect
-1	0	1
