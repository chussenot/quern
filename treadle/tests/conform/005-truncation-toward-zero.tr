# 005 - / and % truncate toward zero (§2), so the remainder takes the sign of
# the DIVIDEND: -7 / 2 == -3 and -7 % 2 == -1. Prefix `-` binds tightest
# (§2 row 7), so `-7 / 2` is (-7)/2 and `7 / -2` is 7/(-2).
--- source
print -7 / 2;
print -7 % 2;
print 7 / -2;
print 7 % -2;
print -7 / -2;
print -7 % -2;
--- expect
-3
-1
-3
1
3
-1
