
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the append-only logs, which are history and belong in git.
.pact/*
!.pact/events.jsonl
!.pact/messages.jsonl

# per-agent worktrees (run 5 topology)
wt/

# rust build artifacts
/target
Cargo.lock

# run 6: harness instrumentation is telemetry, like .pact/ logs — it is history
!.harness/
/treadle/target
